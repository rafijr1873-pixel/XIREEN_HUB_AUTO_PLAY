-- ═══════════════════════════════════════════════════════════
-- PLAY LOGIC
-- ═══════════════════════════════════════════════════════════
local function playSong(notes)
    isPlaying = true
    local startTime = tick()
    local totalNotes = #notes
    
    Status.Text = string.format("Playing: %d notes\nSpeed: %.1fx | Transpose: %+d", totalNotes, currentSpeed, currentTranspose)
    Status.TextColor3 = Color3.fromRGB(150, 255, 150)
    
    task.spawn(function()
        for i, event in ipairs(notes) do
            if not isPlaying then
                Status.Text = "Stopped by user"
                Status.TextColor3 = Color3.fromRGB(255, 200, 100)
                break
            end
            
            -- Wait for correct timing
            local targetTime = event.time / currentSpeed
            local elapsed = tick() - startTime
            if targetTime > elapsed then
                task.wait(targetTime - elapsed)
            end
            
            -- Apply transpose
            local transposedNote = event.note + currentTranspose
            
            -- Filter by range
            if transposedNote >= minNote and transposedNote <= maxNote then
                -- Map to layout
                local index = ((transposedNote - 36) % #Layout) + 1
                local key = Layout[index]
                pressKey(key)
            end
            
            -- Update progress
            local progress = i / totalNotes
            ProgressFill.Size = UDim2.new(progress, 0, 1, 0)
            ProgressLabel.Text = string.format("Progress: %d%%", math.floor(progress * 100))
        end
        
        if isPlaying then
            Status.Text = "Finished playing!\nLoad another MIDI to continue"
            Status.TextColor3 = Color3.fromRGB(100, 255, 255)
        end
        
        isPlaying = false
        ProgressFill.Size = UDim2.new(0, 0, 1, 0)
        ProgressLabel.Text = "Progress: 0%"
    end)
end

-- ═══════════════════════════════════════════════════════════
-- BUTTON EVENTS
-- ═══════════════════════════════════════════════════════════
PlayBtn.MouseButton1Click:Connect(function()
    if isPlaying then
        Status.Text = "Already playing!"
        Status.TextColor3 = Color3.fromRGB(255, 255, 100)
        return
    end
    
    local url = UrlInput.Text:match("^%s*(.-)%s*$") -- Trim whitespace
    
    if url == "" then
        Status.Text = "Error: Please enter a MIDI URL"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    Status.Text = "Downloading MIDI file..."
    Status.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    -- Convert URL
    url = convertURL(url)
    
    -- Download
    task.spawn(function()
        local success, result = pcall(function()
            return game:HttpGet(url, true)
        end)
        
        if not success then
            Status.Text = "Download failed!\nCheck URL or try raw link"
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end
        
        Status.Text = "Parsing MIDI data..."
        Status.TextColor3 = Color3.fromRGB(255, 200, 100)
        
        -- Parse MIDI
        local notes, err = parseMIDI(result)
        
        if not notes then
            Status.Text = string.format("Parse Error:\n%s", err or "Invalid MIDI format")
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end
        
        if #notes == 0 then
            Status.Text = "No notes found in MIDI file"
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end
        
        currentSong = notes
        playSong(notes)
    end)
end)

