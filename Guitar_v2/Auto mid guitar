-- MIDI PARSER CORE
local isPlaying = false

local function parseMidi(data)
    local notes = {}
    local pos = 1
    
    local function read(n)
        local res = data:sub(pos, pos + n - 1)
        pos = pos + n
        return res
    end
    
    local function readByte() return string.byte(read(1)) end
    local function readVlq()
        local val = 0
        repeat
            local b = readByte()
            val = bit32.bor(bit32.lshift(val, 7), bit32.band(b, 0x7F))
        until b < 128
        return val
    end

    if read(4) ~= "MThd" then return nil end
    pos = pos + 4 
    local format = readByte() * 256 + readByte()
    local tracks = readByte() * 256 + readByte()
    local division = readByte() * 256 + readByte()

    for i = 1, tracks do
        while pos <= #data and read(4) ~= "MTrk" do pos = pos + 1 end
        if pos > #data then break end
        
        local trackLen = readByte()*16777216 + readByte()*65536 + readByte()*256 + readByte()
        local trackEnd = pos + trackLen
        local tick = 0
        
        while pos < trackEnd do
            tick = tick + readVlq()
            local status = readByte()
            
            if status == 0xFF then -- Meta
                pos = pos + 1 + readVlq()
            elseif status >= 0x80 then
                local type = bit32.band(status, 0xF0)
                local channel = bit32.band(status, 0x0F)
                local p1 = readByte()
                local p2 = (type ~= 0xC0 and type ~= 0xD0) and readByte() or 0
                
                if type == 0x90 and p2 > 0 then -- Note On
                    table.insert(notes, {time = tick * (0.5/division), note = p1})
                end
            end
        end
    end
    table.sort(notes, function(a,b) return a.time < b.time end)
    return notes
end

-- SIMULASI TEKAN TOMBOL (MOBILE COMPATIBLE)
local function press(key)
    if not key then return end
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

-- LOGIC UTAMA
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

StopBtn.MouseButton1Click:Connect(function()
    isPlaying = false
    Status.Text = "Status: Stopped"
end)

PlayBtn.MouseButton1Click:Connect(function()
    if isPlaying then return end
    
    local url = UrlInput.Text
    if url == "" then Status.Text = "Status: Masukkan URL!"; return end
    
    Status.Text = "Status: Downloading..."
    local success, content = pcall(function() return game:HttpGet(url) end)
    
    if not success then Status.Text = "Status: Download Gagal!"; return end
    
    local song = parseMidi(content)
    if not song then Status.Text = "Status: File Bukan MIDI!"; return end
    
    isPlaying = true
    Status.Text = "Status: Playing..."
    local startTime = tick()
    
    task.spawn(function()
        for _, event in ipairs(song) do
            if not isPlaying then break end
            
            local elapsed = tick() - startTime
            if event.time > elapsed then
                task.wait(event.time - elapsed)
            end
            
            -- Mapping MIDI note ke Layout Gambar (Otomatis Transpose)
            -- Kita ambil nada tengah MIDI (60) sebagai patokan
            local index = (event.note - 36) % #Layout + 1
            press(Layout[index])
        end
        isPlaying = false
        Status.Text = "Status: Finished"
    end)
end)
