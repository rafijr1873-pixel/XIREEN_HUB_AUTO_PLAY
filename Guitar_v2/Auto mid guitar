-- ═══════════════════════════════════════════════════════════
-- URL CONVERTER (Support Discord, GitHub, etc)
-- ═══════════════════════════════════════════════════════════
local function convertURL(url)
    -- Discord CDN
    if url:match("discord%.com/attachments") or url:match("cdn%.discordapp%.com") then
        return url
    end
    
    -- GitHub (Convert to raw)
    if url:match("github%.com") and not url:match("raw%.githubusercontent%.com") then
        url = url:gsub("github%.com", "raw.githubusercontent.com")
        url = url:gsub("/blob/", "/")
    end
    
    -- Dropbox
    if url:match("dropbox%.com") then
        url = url:gsub("www%.dropbox%.com", "dl.dropboxusercontent.com")
        url = url:gsub("dl=0", "dl=1")
    end
    
    return url
end

-- ═══════════════════════════════════════════════════════════
-- MIDI PARSER (IMPROVED)
-- ═══════════════════════════════════════════════════════════
local function parseMIDI(data)
    local notes = {}
    local pos = 1
    
    local function read(n)
        if pos + n - 1 > #data then return string.rep("\0", n) end
        local res = data:sub(pos, pos + n - 1)
        pos = pos + n
        return res
    end
    
    local function readByte()
        if pos > #data then return 0 end
        return string.byte(read(1))
    end
    
    local function readWord()
        local b1, b2 = readByte(), readByte()
        return b1 * 256 + b2
    end
    
    local function readDWord()
        local b1, b2, b3, b4 = readByte(), readByte(), readByte(), readByte()
        return b1 * 16777216 + b2 * 65536 + b3 * 256 + b4
    end
    
    local function readVLQ()
        local val = 0
        local b
        repeat
            b = readByte()
            val = bit32.lshift(val, 7) + bit32.band(b, 0x7F)
        until b < 128
        return val
    end
    
    -- Parse Header
    local header = read(4)
    if header ~= "MThd" then
        return nil, "Invalid MIDI file (missing MThd)"
    end
    
    local headerLen = readDWord()
    local format = readWord()
    local trackCount = readWord()
    local division = readWord()
    
    local tempo = 500000 -- Default tempo (120 BPM)
    local ticksPerQuarter = division
    
    if bit32.band(division, 0x8000) ~= 0 then
        return nil, "SMPTE time division not supported"
    end
    
    -- Parse Tracks
    for trackNum = 1, trackCount do
        -- Find MTrk
        while pos <= #data - 4 do
            if read(4) == "MTrk" then
                break
            else
                pos = pos - 3
            end
        end
        
        if pos > #data then break end
        
        local trackLen = readDWord()
        local trackEnd = pos + trackLen
        local tick = 0
        local runningStatus = 0
        
        while pos < trackEnd do
            local delta = readVLQ()
            tick = tick + delta
            
            local statusByte = readByte()
            
            -- Handle running status
            if statusByte < 0x80 then
                pos = pos - 1
                statusByte = runningStatus
            else
                runningStatus = statusByte
            end
            
            local eventType = bit32.band(statusByte, 0xF0)
            local channel = bit32.band(statusByte, 0x0F)
            
            if eventType == 0x80 or eventType == 0x90 then
                -- Note Off / Note On
                local note = readByte()
                local velocity = readByte()
                
                if eventType == 0x90 and velocity > 0 then
                    local timeInSeconds = tick * (tempo / 1000000) / ticksPerQuarter
                    table.insert(notes, {
                        time = timeInSeconds,
                        note = note,
                        velocity = velocity
                    })
                end
                
            elseif eventType == 0xA0 or eventType == 0xB0 or eventType == 0xE0 then
                -- Aftertouch / Control Change / Pitch Bend
                readByte()
                readByte()
                
            elseif eventType == 0xC0 or eventType == 0xD0 then
                -- Program Change / Channel Pressure
                readByte()
                
            elseif eventType == 0xF0 then
                if statusByte == 0xFF then
                    -- Meta Event
                    local metaType = readByte()
                    local metaLen = readVLQ()
                    
                    if metaType == 0x51 and metaLen == 3 then
                        -- Tempo change
                        tempo = readByte() * 65536 + readByte() * 256 + readByte()
                    else
                        pos = pos + metaLen
                    end
                    
                    runningStatus = 0
                elseif statusByte == 0xF0 or statusByte == 0xF7 then
                    -- SysEx
                    local sysexLen = readVLQ()
                    pos = pos + sysexLen
                    runningStatus = 0
                end
            end
        end
        
        pos = trackEnd
    end
    
    -- Sort by time
    table.sort(notes, function(a, b) return a.time < b.time end)
    
    return notes
end

-- ═══════════════════════════════════════════════════════════
-- KEY PRESS SIMULATION
-- ═══════════════════════════════════════════════════════════
local function pressKey(key)
    if not key or key == "" then return end
    
    local success = pcall(function()
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
    
    if not success then
        -- Fallback method
        pcall(function()
            game:GetService("VirtualUser"):TypeKey(key)
        end)
    end
end

-- ═══════════════════════════════════════════════════════════
-- SLIDER LOGIC
-- ═══════════════════════════════════════════════════════════
local function setupSlider(slider, button, fill, minVal, maxVal, defaultVal, callback)
    local dragging = false
    local value = defaultVal
    
    local function update(input)
        local pos = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        value = minVal + (maxVal - minVal) * pos
        
        button.Position = UDim2.new(pos, -10, 0.5, -10)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        
        callback(value)
    end
    
    button.MouseButton1Down:Connect(function()
        dragging = true
    end)
    
    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            update(input)
        end
    end)
    
    -- Set initial value
    local initialPos = (defaultVal - minVal) / (maxVal - minVal)
    button.Position = UDim2.new(initialPos, -10, 0.5, -10)
    fill.Size = UDim2.new(initialPos, 0, 1, 0)
end

