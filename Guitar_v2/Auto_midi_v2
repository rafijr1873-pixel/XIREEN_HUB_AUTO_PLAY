-- URL CONVERTER
-- ═══════════════════════════════════════════════════════════
local function fixURL(url)
    url = url:gsub("^%s*(.-)%s*$", "%1") -- Trim
    
    -- Discord
    if url:match("discord") and not url:match("^https?://") then
        url = "https://" .. url
    end
    
    -- GitHub to raw
    if url:match("github%.com") and not url:match("raw%.githubusercontent") then
        url = url:gsub("github%.com", "raw.githubusercontent.com")
        url = url:gsub("/blob/", "/")
    end
    
    -- Dropbox
    if url:match("dropbox") then
        url = url:gsub("www%.dropbox%.com", "dl.dropboxusercontent.com")
        url = url:gsub("dl=0", "dl=1")
    end
    
    return url
end

-- ═══════════════════════════════════════════════════════════
-- MIDI PARSER (SIMPLIFIED & WORKING)
-- ═══════════════════════════════════════════════════════════
local function parseMIDI(data)
    local notes = {}
    local pos = 1
    
    local function read(n)
        if pos + n > #data then return string.rep("\0", n) end
        local result = data:sub(pos, pos + n - 1)
        pos = pos + n
        return result
    end
    
    local function readByte()
        return string.byte(read(1))
    end
    
    local function readShort()
        return readByte() * 256 + readByte()
    end
    
    local function readInt()
        return readByte() * 16777216 + readByte() * 65536 + readByte() * 256 + readByte()
    end
    
    local function readVarLen()
        local value = 0
        local byte
        repeat
            byte = readByte()
            value = bit32.lshift(value, 7) + bit32.band(byte, 127)
        until byte < 128
        return value
    end
    
    -- Check header
    if read(4) ~= "MThd" then
        return nil, "Not a valid MIDI file"
    end
    
    local headerSize = readInt()
    local format = readShort()
    local trackCount = readShort()
    local division = readShort()
    
    if bit32.band(division, 0x8000) ~= 0 then
        return nil, "SMPTE timing not supported"
    end
    
    local ticksPerBeat = division
    local tempo = 500000 -- 120 BPM
    
    print(string.format("📄 MIDI: Format=%d, Tracks=%d, Division=%d", format, trackCount, division))
    
    -- Parse tracks
    for t = 1, trackCount do
        -- Find MTrk
        while pos <= #data - 8 do
            if read(4) == "MTrk" then
                break
            else
                pos = pos - 3
            end
        end
        
        if pos > #data then break end
        
        local trackSize = readInt()
        local trackEnd = pos + trackSize
        
        local time = 0
        local lastStatus = 0
        
        while pos < trackEnd and pos <= #data do
            local delta = readVarLen()
            time = time + delta
            
            local status = readByte()
            
            -- Running status
            if status < 0x80 then
                pos = pos - 1
                status = lastStatus
            else
                if status < 0xF0 then
                    lastStatus = status
                end
            end
            
            local cmd = bit32.band(status, 0xF0)
            
            if cmd == 0x90 then
                -- Note On
                local note = readByte()
                local velocity = readByte()
                
                if velocity > 0 then
                    local timeInSeconds = time * tempo / ticksPerBeat / 1000000
                    table.insert(notes, {
                        time = timeInSeconds,
                        note = note,
                        velocity = velocity
                    })
                end
                
            elseif cmd == 0x80 then
                -- Note Off
                readByte()
                readByte()
                
            elseif cmd == 0xA0 or cmd == 0xB0 or cmd == 0xE0 then
                -- Other 2-byte commands
                readByte()
                readByte()
                
            elseif cmd == 0xC0 or cmd == 0xD0 then
                -- 1-byte commands
                readByte()
                
            elseif status == 0xFF then
                -- Meta event
                local type = readByte()
                local length = readVarLen()
                
                if type == 0x51 and length == 3 then
                    -- Tempo change
                    tempo = readByte() * 65536 + readByte() * 256 + readByte()
                else
                    pos = pos + length
                end
                
            elseif status == 0xF0 or status == 0xF7 then
                -- SysEx
                local length = readVarLen()
                pos = pos + length
            end
        end
        
        pos = trackEnd
    end
    
    -- Sort notes by time
    table.sort(notes, function(a, b) return a.time < b.time end)
    
    print(string.format("✅ Parsed %d notes", #notes))
    
    return notes
end

