PlayBtn.MouseButton1Click:Connect(function()
    if isPlaying then
        Status.Text = "⚠️ Already playing!"
        Status.TextColor3 = Color3.fromRGB(255, 255, 100)
        return
    end
    
    local url = UrlInput.Text:match("^%s*(.-)%s*$")
    
    if url == "" or url == "Paste MIDI URL here..." then
        Status.Text = "❌ Please enter a valid MIDI URL!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    Status.Text = "⏳ Downloading MIDI file...\nPlease wait..."
    Status.TextColor3 = Color3.fromRGB(255, 200, 100)
    StatusIcon.Text = "⏳"
    
    url = convertURL(url)
    
    task.spawn(function()
        local success, response = pcall(function()
            return game:HttpGet(url, true)
        end)
        
        if not success then
            Status.Text = string.format("❌ Download Failed!\n\n%s\n\nTry:\n• Raw GitHub link\n• Discord CDN\n• Direct .mid link", tostring(response):sub(1, 100))
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusIcon.Text = "❌"
            return
        end
        
        Status.Text = "⚙️ Parsing MIDI data..."
        StatusIcon.Text = "⚙️"
        task.wait(0.1)
        
        local notes, err = parseMIDI(response)
        
        if not notes then
            Status.Text = string.format("❌ MIDI Parse Error!\n\n%s", err or "Invalid MIDI file format")
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusIcon.Text = "❌"
            return
        end
        
        if #notes == 0 then
            Status.Text = "⚠️ No notes found!\n\nThe MIDI file has no playable notes."
            Status.TextColor3 = Color3.fromRGB(255, 200, 100)
            StatusIcon.Text = "⚠️"
            return
        end
        
        Status.Text = string.format("✅ MIDI Loaded!\n%d notes ready\n\nStarting playback...", #notes)
        Status.TextColor3 = Color3.fromRGB(100, 255, 150)
        StatusIcon.Text = "✅"
        task.wait(0.5)
        
        playSong(notes)
    end)
end)

