-- ═══════════════════════════════════════════════════════════
-- PLAY FUNCTION
-- ═══════════════════════════════════════════════════════════
local function playSong(notes)
    if #notes == 0 then
        Status.Text = "❌ No notes found in MIDI file!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    isPlaying = true
    currentNotes = notes
    currentNoteIndex = 1
    
    minNote = tonumber(MinNoteInput.Text) or 36
    maxNote = tonumber(MaxNoteInput.Text) or 96
    
    local totalNotes = #notes
    local playedNotes = 0
    local startTime = tick()
    
    Status.Text = string.format("🎵 Playing...\nTotal Notes: %d\nSpeed: %.2fx | Transpose: %+d", totalNotes, currentSpeed, currentTranspose)
    Status.TextColor3 = Color3.fromRGB(100, 255, 150)
    StatusIcon.Text = "🎵"
    
    task.spawn(function()
        for i, noteData in ipairs(notes) do
            if not isPlaying then
                Status.Text = "⏹️ Stopped by user"
                Status.TextColor3 = Color3.fromRGB(255, 200, 100)
                StatusIcon.Text = "⏹️"
                break
            end
            
            currentNoteIndex = i
            
            -- Wait for correct timing
            local targetTime = noteData.time / currentSpeed
            local elapsed = tick() - startTime
            
            if targetTime > elapsed then
                task.wait(targetTime - elapsed)
            end
            
            -- Apply transpose
            local finalNote = noteData.note + currentTranspose
            
            -- Filter range
            if finalNote >= minNote and finalNote <= maxNote then
                -- Map to guitar keys (optimized wrapping)
                local keyIndex = ((finalNote - minNote) % #GuitarKeys) + 1
                local key = GuitarKeys[keyIndex]
                
                pressKey(key)
                playedNotes = playedNotes + 1
            end
            
            -- Update progress
            local progress = i / totalNotes
            ProgressFill.Size = UDim2.new(progress, 0, 1, 0)
            ProgressLabel.Text = string.format("📊 PROGRESS: %d%% (%d/%d)", math.floor(progress * 100), i, totalNotes)
            
            -- Update status every 50 notes
            if i % 50 == 0 then
                Status.Text = string.format("🎵 Playing...\nNote: %d/%d (Played: %d)\nTime: %.1fs", i, totalNotes, playedNotes, elapsed)
            end
        end
        
        if isPlaying then
            Status.Text = string.format("✅ Finished!\nPlayed %d/%d notes\nTime: %.1fs", playedNotes, totalNotes, tick() - startTime)
            Status.TextColor3 = Color3.fromRGB(100, 255, 255)
            StatusIcon.Text = "✅"
        end
        
        isPlaying = false
        ProgressFill.Size = UDim2.new(0, 0, 1, 0)
        ProgressLabel.Text = "📊 PROGRESS: 0%"
    end)
end

