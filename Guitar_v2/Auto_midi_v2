-- URL CONVERTER
-- ═══════════════════════════════════════════════════════════
local function convertURL(url)
    url = url:gsub("^%s*(.-)%s*$", "%1") -- Trim
    
    -- Discord
    if url:match("discord") then
        if not url:match("^https?://") then
            url = "https://" .. url
        end
        return url
    end
    
    -- GitHub
    if url:match("github%.com") then
        url = url:gsub("github%.com", "raw.githubusercontent.com")
        url = url:gsub("/blob/", "/")
    end
    
    -- Dropbox
    if url:match("dropbox") then
        url = url:gsub("www%.dropbox%.com", "dl.dropboxusercontent.com")
        url = url:gsub("dl=0", "dl=1")
    end
    
    -- Google Drive
    if url:match("drive%.google%.com") then
        local id = url:match("/d/([%w-_]+)")
        if id then
            url = "https://drive.google.com/uc?export=download&id=" .. id
        end
    end
    
    return url
end

-- ═══════════════════════════════════════════════════════════
-- IMPROVED MIDI PARSER
-- ═══════════════════════════════════════════════════════════
local function parseMIDI(data)
    local notes = {}
    local pos = 1
    local tempos = {}
    
    local function read(n)
        if pos + n - 1 > #data then 
            return string.rep("\0", n) 
        end
        local res = data:sub(pos, pos + n - 1)
        pos = pos + n
        return res
    end
    
    local function readByte()
        if pos > #data then return 0 end
        return string.byte(read(1))
    end
    
    local function readWord()
        return readByte() * 256 + readByte()
    end
    
    local function readDWord()
        return readByte() * 16777216 + readByte() * 65536 + readByte() * 256 + readByte()
    end
    
    local function readVLQ()
        local val = 0
        local b
        repeat
            b = readByte()
            val = bit32.lshift(val, 7) + bit32.band(b, 0x7F)
        until b < 128
        return val
    end
    
    -- Header
    if read(4) ~= "MThd" then
        return nil, "Invalid MIDI: No MThd header"
    end
    
    local headerLen = readDWord()
    local format = readWord()
    local trackCount = readWord()
    local division = readWord()
    
    if bit32.band(division, 0x8000) ~= 0 then
        return nil, "SMPTE timing not supported"
    end
    
    local ticksPerBeat = division
    local microsecondsPerBeat = 500000 -- 120 BPM default
    
    -- Parse all tracks
    for trackIdx = 1, trackCount do
        -- Find MTrk
        while pos <= #data - 8 do
            if read(4) == "MTrk" then
                break
            else
                pos = pos - 3
            end
        end
        
        if pos > #data then break end
        
        local trackLen = readDWord()
        local trackEnd = pos + trackLen
        local tick = 0
        local runningStatus = 0
        
        while pos < trackEnd and pos < #data do
            local delta = readVLQ()
            tick = tick + delta
            
            local statusByte = readByte()
            
            -- Running status
            if statusByte < 0x80 then
                pos = pos - 1
                statusByte = runningStatus
            else
                if statusByte < 0xF0 then
                    runningStatus = statusByte
                end
            end
            
            local command = bit32.band(statusByte, 0xF0)
            local channel = bit32.band(statusByte, 0x0F)
            
            if command == 0x90 then
                -- Note On
                local note = readByte()
                local velocity = readByte()
                
                if velocity > 0 then
                    local timeSeconds = tick * microsecondsPerBeat / ticksPerBeat / 1000000
                    table.insert(notes, {
                        time = timeSeconds,
                        note = note,
                        velocity = velocity,
                        tick = tick
                    })
                end
                
            elseif command == 0x80 then
                -- Note Off
                readByte()
                readByte()
                
            elseif command == 0xA0 or command == 0xB0 or command == 0xE0 then
                readByte()
                readByte()
                
            elseif command == 0xC0 or command == 0xD0 then
                readByte()
                
            elseif statusByte == 0xFF then
                -- Meta Event
                local metaType = readByte()
                local metaLen = readVLQ()
                
                if metaType == 0x51 and metaLen == 3 then
                    -- Set Tempo
                    microsecondsPerBeat = readByte() * 65536 + readByte() * 256 + readByte()
                    table.insert(tempos, {tick = tick, uspb = microsecondsPerBeat})
                else
                    pos = pos + metaLen
                end
                
            elseif statusByte == 0xF0 or statusByte == 0xF7 then
                -- SysEx
                local len = readVLQ()
                pos = pos + len
            end
        end
        
        pos = trackEnd
    end
    
    -- Apply tempo changes
    if #tempos > 0 then
        for i = 1, #notes do
            local note = notes[i]
            local currentTempo = 500000
            
            for j = 1, #tempos do
                if tempos[j].tick <= note.tick then
                    currentTempo = tempos[j].uspb
                else
                    break
                end
            end
            
            note.time = note.tick * currentTempo / ticksPerBeat / 1000000
        end
    end
    
    table.sort(notes, function(a, b) return a.time < b.time end)
    
    return notes
end

