-- KEY PRESS (MOBILE + PC)
-- ═══════════════════════════════════════════════════════════
local function pressKey(key)
    if not key then return end
    
    task.spawn(function()
        local success = pcall(function()
            -- Method 1: VirtualInputManager
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.03)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
        
        if not success then
            -- Method 2: VirtualUser (Fallback)
            pcall(function()
                local VirtualUser = game:GetService("VirtualUser")
                VirtualUser:TypeKey(key)
            end)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- SLIDER SYSTEM (TOUCH COMPATIBLE)
-- ═══════════════════════════════════════════════════════════
local function createSlider(sliderFrame, knob, fill, minVal, maxVal, defaultVal, callback)
    local value = defaultVal
    local dragging = false
    
    local function updateValue(inputPos)
        local relativeX = math.clamp((inputPos.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
        value = minVal + (maxVal - minVal) * relativeX
        
        knob.Position = UDim2.new(relativeX, -knob.AbsoluteSize.X/2, 0.5, -knob.AbsoluteSize.Y/2)
        fill.Size = UDim2.new(relativeX, 0, 1, 0)
        
        callback(value, relativeX)
    end
    
    sliderFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateValue(input.Position)
        end
    end)
    
    sliderFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input.Position)
        end
    end)
    
    -- Set initial
    local initialPos = (defaultVal - minVal) / (maxVal - minVal)
    knob.Position = UDim2.new(initialPos, -knob.AbsoluteSize.X/2, 0.5, -knob.AbsoluteSize.Y/2)
    fill.Size = UDim2.new(initialPos, 0, 1, 0)
end

