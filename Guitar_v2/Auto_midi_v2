PlayBtn.MouseButton1Click:Connect(function()
    if isPlaying then
        Status.Text = "⚠️ Already playing!"
        Status.TextColor3 = Color3.fromRGB(255, 255, 100)
        return
    end
    
    local url = UrlBox.Text:match("^%s*(.-)%s*$")
    
    if url == "" then
        Status.Text = "❌ Enter MIDI URL!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    Status.Text = "⏳ Downloading..."
    Status.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    url = fixURL(url)
    print("📥 Downloading: " .. url)
    
    task.spawn(function()
        local ok, data = pcall(function()
            return game:HttpGet(url, true)
        end)
        
        if not ok then
            Status.Text = "❌ Download failed!\n\n" .. tostring(data):sub(1, 100)
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            print("❌ Error: " .. tostring(data))
            return
        end
        
        print("✅ Downloaded " .. #data .. " bytes")
        
        Status.Text = "⚙️ Parsing MIDI..."
        task.wait(0.2)
        
        local notes, err = parseMIDI(data)
        
        if not notes then
            Status.Text = "❌ Parse error!\n\n" .. (err or "Invalid MIDI")
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            print("❌ Parse error: " .. tostring(err))
            return
        end
        
        Status.Text = string.format("✅ Loaded %d notes!\n\nStarting...", #notes)
        Status.TextColor3 = Color3.fromRGB(0, 255, 150)
        task.wait(0.5)
        
        playSong(notes)
    end)
end)

