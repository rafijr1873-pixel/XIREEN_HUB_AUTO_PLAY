local function pressKey(key)
    if not key or key == "" then return end
    
    task.spawn(function()
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key] or key, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key] or key, false, game)
        end)
    end)
end

