-- ═══════════════════════════════════════════════════════════
-- PLAY FUNCTION
-- ═══════════════════════════════════════════════════════════
local function playSong(notes)
    if #notes == 0 then
        Status.Text = "❌ No notes found!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    isPlaying = true
    
    local minNote = tonumber(MinBox.Text) or 36
    local maxNote = tonumber(MaxBox.Text) or 96
    
    local startTime = tick()
    local played = 0
    
    Status.Text = string.format("🎵 PLAYING\n\nNotes: %d\nSpeed: %.2fx\nTranspose: %+d", #notes, currentSpeed, currentTranspose)
    Status.TextColor3 = Color3.fromRGB(0, 255, 150)
    
    task.spawn(function()
        for i, n in ipairs(notes) do
            if not isPlaying then
                Status.Text = "⏹️ STOPPED"
                Status.TextColor3 = Color3.fromRGB(255, 200, 100)
                break
            end
            
            -- Timing
            local targetTime = n.time / currentSpeed
            local elapsed = tick() - startTime
            
            if targetTime > elapsed then
                task.wait(targetTime - elapsed)
            end
            
            -- Apply transpose
            local note = n.note + currentTranspose
            
            -- Filter range
            if note >= minNote and note <= maxNote then
                -- Map to key
                local keyIndex = ((note - minNote) % #GuitarKeys) + 1
                local key = GuitarKeys[keyIndex]
                pressKey(key)
                played = played + 1
            end
            
            -- Update progress
            local prog = i / #notes
            ProgFill.Size = UDim2.new(prog, 0, 1, 0)
            ProgLabel.Text = string.format("📊 PROGRESS: %d%%", math.floor(prog * 100))
            
            -- Update status every 100 notes
            if i % 100 == 0 then
                Status.Text = string.format("🎵 PLAYING\n\nNote: %d/%d\nPlayed: %d\nElapsed: %.1fs", i, #notes, played, elapsed)
            end
        end
        
        if isPlaying then
            Status.Text = string.format("✅ FINISHED!\n\nPlayed: %d notes\nTime: %.1fs", played, tick() - startTime)
            Status.TextColor3 = Color3.fromRGB(0, 255, 255)
        end
        
        isPlaying = false
        ProgFill.Size = UDim2.new(0, 0, 1, 0)
        ProgLabel.Text = "📊 PROGRESS: 0%"
    end)
end

